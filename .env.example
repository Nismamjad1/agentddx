# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Required: OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Contact address sent to NCBI Entrez, as required by their usage policy
PUBMED_EMAIL=you@example.org

# Optional overrides — defaults below match the paper
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# MAX_PAPERS=3
# RELEVANCE_THRESHOLD=0.4
# SELF_CONSISTENCY=1
